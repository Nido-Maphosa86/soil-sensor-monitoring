@* What this file is for: the dark brand panel on the left of the sign in pages (W1 and W1b). The same panel, with the drawing, is used on every sign in page.
   How it fits in: shared by Login, Forgot and ForgotSent so they look like one screen in different states. It is a fluid column that stacks above the form on small screens. *@
@model bool
<div class="auth-art">
  <div class="glow" style="width:780px;height:780px;left:-220px;top:-300px;background:rgba(16,121,90,.55);filter:blur(230px)"></div>
  <div class="glow" style="width:460px;height:460px;right:-100px;bottom:-60px;background:rgba(97,201,160,.20);filter:blur(190px)"></div>
  <div class="brand">@Ui.Mark(52, 16) SensorGrid</div>
  <h1>Three provinces.<br>Fifteen sensors.<br>One console.</h1>
  <p>Soil sensors across the Free State, Gauteng and North West report every thirty minutes. This console handles sensors, thresholds, the readings log and reporting.</p>

  @if (Model)
  {
  <div class="art">
  <svg viewBox="0 0 660 400">
    <rect x="0" y="180" width="660" height="70" fill="#61C9A0" fill-opacity=".13"/>
    <rect x="0" y="250" width="660" height="70" fill="#61C9A0" fill-opacity=".09"/>
    <rect x="0" y="320" width="660" height="80" fill="#61C9A0" fill-opacity=".05"/>
    <line x1="0" y1="250" x2="660" y2="250" stroke="#FFFFFF" stroke-opacity=".07"/>
    <line x1="0" y1="320" x2="660" y2="320" stroke="#FFFFFF" stroke-opacity=".07"/>
    <line x1="0" y1="180" x2="660" y2="180" stroke="#61C9A0" stroke-opacity=".45" stroke-width="1.5"/>
    <g fill="none" stroke="#61C9A0" stroke-opacity=".32" stroke-width="1.6" stroke-linecap="round">
      <path d="M180 182 C176 210 160 232 142 252"/><path d="M180 182 C184 214 202 236 222 258"/><path d="M180 182 C180 215 178 246 176 280"/>
      <path d="M177 238 C167 250 158 256 149 260"/><path d="M179 212 C190 224 198 229 207 233"/>
    </g>
    <path d="M180 182 C175 146 185 110 180 52" fill="none" stroke="#4FB68E" stroke-width="3" stroke-linecap="round"/>
    <g fill="#61C9A0">
      <ellipse cx="152" cy="144" rx="26" ry="9" transform="rotate(-20 152 144)"/><ellipse cx="208" cy="144" rx="26" ry="9" transform="rotate(20 208 144)"/>
      <ellipse cx="157" cy="109" rx="23" ry="8" transform="rotate(-24 157 109)" fill="#4FB68E"/><ellipse cx="203" cy="109" rx="23" ry="8" transform="rotate(24 203 109)" fill="#4FB68E"/>
      <ellipse cx="161" cy="78" rx="19" ry="7" transform="rotate(-28 161 78)"/><ellipse cx="199" cy="78" rx="19" ry="7" transform="rotate(28 199 78)"/>
      <ellipse cx="180" cy="56" rx="8.5" ry="17"/>
    </g>
    <g fill="none" stroke="#61C9A0" stroke-width="2" stroke-linecap="round">
      <path d="M412 96 A 20 20 0 0 1 448 96" stroke-opacity=".55"/><path d="M400 88 A 34 34 0 0 1 460 88" stroke-opacity=".33"/><path d="M388 80 A 48 48 0 0 1 472 80" stroke-opacity=".18"/>
    </g>
    <rect x="414" y="104" width="32" height="76" rx="12" fill="#61C9A0"/>
    <rect x="421" y="116" width="18" height="4" rx="2" fill="#0D2620" fill-opacity=".5"/><rect x="421" y="126" width="12" height="4" rx="2" fill="#0D2620" fill-opacity=".35"/>
    <rect x="410" y="176" width="40" height="7" rx="3.5" fill="#61C9A0"/>
    <g stroke="#61C9A0" stroke-width="3" stroke-linecap="round"><line x1="419" y1="183" x2="419" y2="286"/><line x1="430" y1="183" x2="430" y2="298"/><line x1="441" y1="183" x2="441" y2="286"/></g>
    <g>
      <circle cx="450" cy="213" r="2.5" fill="#61C9A0"/><line x1="452" y1="213" x2="470" y2="213" stroke="#61C9A0" stroke-opacity=".4"/>
      <circle cx="450" cy="269" r="2.5" fill="#61C9A0"/><line x1="452" y1="269" x2="470" y2="269" stroke="#61C9A0" stroke-opacity=".4"/>
      <circle cx="450" cy="325" r="2.5" fill="#61C9A0"/><line x1="452" y1="325" x2="470" y2="325" stroke="#61C9A0" stroke-opacity=".4"/>
    </g>
    <g font-family="Inter">
      <rect x="470" y="196" width="166" height="34" rx="10" fill="#FFFFFF" fill-opacity=".07" stroke="#61C9A0" stroke-opacity=".25"/>
      <text x="486" y="218" font-size="11" fill="#9FB5AC">Moisture</text><text x="620" y="218" font-size="13" font-weight="600" fill="#F2F6F3" text-anchor="end">24.6 %</text>
      <rect x="470" y="252" width="166" height="34" rx="10" fill="#FFFFFF" fill-opacity=".07" stroke="#61C9A0" stroke-opacity=".25"/>
      <text x="486" y="274" font-size="11" fill="#9FB5AC">Nitrogen</text><text x="620" y="274" font-size="13" font-weight="600" fill="#F2F6F3" text-anchor="end">112 mg/kg</text>
      <rect x="470" y="308" width="166" height="34" rx="10" fill="#FFFFFF" fill-opacity=".07" stroke="#61C9A0" stroke-opacity=".25"/>
      <text x="486" y="330" font-size="11" fill="#9FB5AC">pH level</text><text x="620" y="330" font-size="13" font-weight="600" fill="#F2F6F3" text-anchor="end">6.8</text>
    </g>
  </svg>
  </div>
  }
  <div class="provinces">
    @foreach (var (n, c) in new[] { ("Free State", "5 sensors"), ("Gauteng", "5 sensors"), ("North West", "5 sensors") })
    {
      <div><div style="font-size:14px;font-weight:600;color:#F2F6F3">@n</div>
      <div style="font-size:12px;color:var(--mint);margin-top:4px">@c</div></div>
    }
  </div>
</div>
