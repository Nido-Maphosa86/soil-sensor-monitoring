@* Shown for unexpected errors. It never shows technical details to the person. *@
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="auth-form" style="min-height:100vh">
  <div class="auth-box">
    <div class="h3">Something went wrong</div>
    <div style="font-size:13px;color:var(--tx2);margin-top:10px">Please go back and try again.</div>
    <a class="btn" href="/" style="margin-top:22px">Back to the dashboard</a>
  </div>
</div>
