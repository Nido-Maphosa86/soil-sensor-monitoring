@* Shown for every address until all Firebase settings are filled in. Same brand panel as the sign in page; the right side lists what is missing. *@
@model SensorGrid.Repository.ConnectionState
@{
    ViewData["Title"] = "Waiting for Firebase";
}
<div class="auth">
<partial name="~/Views/Account/_AuthPanel.cshtml" model="true" />
<div class="auth-form">
<div class="auth-box">
  <div style="width:56px;height:56px;border-radius:16px;background:#E3F1EB;display:flex;align-items:center;justify-content:center">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#10795A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="6" rx="7.5" ry="2.8"/><path d="M4.5 6v6c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8V6"/><path d="M4.5 12v6c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8v-6"/></svg>
  </div>
  <div class="eyebrow" style="color:var(--brand);letter-spacing:1.6px;margin-top:24px">SETUP</div>
  <div style="font-size:clamp(26px,3vw,30px);font-weight:700;margin-top:14px">Waiting for the Firebase connection</div>
  <div style="font-size:15px;color:var(--tx2);margin-top:12px;line-height:1.6">The console is ready. It will open as soon as these settings are filled in on the web server and the app is restarted:</div>
  <div style="margin-top:18px;display:flex;flex-direction:column;gap:8px">
    @foreach (var name in Model.Missing)
    {
      <div style="display:flex;gap:10px;align-items:flex-start;font-size:13px">
        <s style="width:8px;height:8px;border-radius:50%;background:#DE9A2E;display:block;margin-top:5px;flex:0 0 auto"></s>
        <code style="font-family:ui-monospace,Consolas,monospace;color:var(--tx);word-break:break-all">@name</code></div>
    }
  </div>
  <div style="font-size:13px;color:var(--tx3);margin-top:22px;line-height:1.6">See the "Connect Firebase" steps in README.md. Settings are kept in user-secrets or environment variables, never in the repository.</div>
</div>
</div>
</div>
