@* W8 Thresholds (administrators only): one tab per province, a min/max card per parameter, saved together. *@
@model ThresholdEditorDto
@{
    ViewData["Title"] = "Thresholds";
    ViewData["Nav"] = "Thresholds";
    ViewData["Heading"] = "Thresholds";
    ViewData["Sub"] = "Bands are set per province, because soil and climate differ across the three";
}
@section Right {
  <form method="post" asp-action="Reset" asp-route-site="@Model.SiteId" style="display:contents"><button class="btn ghost" type="submit" data-confirm="Reset all bands for this province to the defaults?">Reset to defaults</button></form>
  <button class="btn" type="submit" form="thrForm">Save changes</button>
}
<div class="tabs">
  @foreach (var (id, name) in Model.Provinces)
  {
    <a class="@(id == Model.SiteId ? "on" : "")" asp-action="Index" asp-route-site="@id">@name</a>
  }
</div>
<div class="cap" style="margin-top:-8px">Crop: <b style="font-weight:600;color:var(--tx)">@Model.Crop</b> · @Model.Caption</div>

<form id="thrForm" method="post" asp-action="Save">
<input type="hidden" name="site" value="@Model.SiteId" />
<div class="card" style="margin-bottom:16px;padding:16px 20px">
  <div class="eyebrow">BASIS FOR THESE BANDS</div>
  <div class="inp" style="margin-top:8px"><input name="basis" value="@Model.Basis" maxlength="300" placeholder="e.g. Agronomy guideline for pigeon pea, 2026" /></div>
  @if (Model.BasisError is not null){<div class="hint" style="color:#C0392F">@Model.BasisError</div>}
</div>
<div class="grid g4 single">
@foreach (var c in Model.Cards)
{
  <div class="card" style="padding:18px 20px;@(c.Error is null ? "" : "border:1px solid #C0392F")">
    <div style="display:flex;align-items:center;gap:8px">
      <s style="width:20px;height:4px;border-radius:2px;background:@c.Colour;display:block"></s>
      <span style="font-size:13px;font-weight:600">@c.Label</span>
      <span class="cap" style="margin-left:auto">@c.Unit</span></div>
    <div style="display:flex;gap:10px;margin-top:13px">
      <div style="flex:1;min-width:0"><div class="eyebrow">MINIMUM</div>
        <div class="inp" style="height:36px;border-radius:9px;margin-top:5px;font-weight:600"><input name="min_@c.Parameter" value="@c.Min" inputmode="decimal" required maxlength="10" aria-label="@c.Label minimum" /></div></div>
      <div style="flex:1;min-width:0"><div class="eyebrow">MAXIMUM</div>
        <div class="inp" style="height:36px;border-radius:9px;margin-top:5px;font-weight:600"><input name="max_@c.Parameter" value="@c.Max" inputmode="decimal" required maxlength="10" aria-label="@c.Label maximum" /></div></div></div>
    <div class="rng" style="margin-top:15px;margin-bottom:18px">
      <div style="height:5px;border-radius:3px;background:#E7EDE9"></div>
      <div style="position:absolute;left:18%;top:0;width:58%;height:5px;border-radius:3px;background:rgba(97,201,160,.55)"></div>
      <div style="position:absolute;left:calc(@(c.Position)% - 5px);top:-3px;width:11px;height:11px;border-radius:50%;background:#fff;border:3px solid @c.Colour"></div>
      <div style="position:absolute;right:0;top:10px;font-size:10px;font-weight:600;color:var(--tx2)">now @c.Current</div></div>
    @if (c.Error is not null){<div class="errtext">@c.Error</div>}
  </div>
}
</div>
</form>

<div class="card">
  <div class="cardhead">
    <div class="h3">When a reading falls outside the band</div>
    <div class="cap">These rules apply to every sensor at this site.</div></div>
  <div class="grid g3" style="gap:14px">
    @foreach (var (t, s, on) in new[] { ("Raise an alert", "Appears on both applications", true), ("Email the site officer", "Sent once per breach, not per reading", true), ("Send a push notification", "Available after the messaging integration", false) })
    {
      <div style="border:1px solid var(--line);border-radius:11px;padding:13px 15px;display:flex;align-items:center;gap:11px;@(on ? "" : "opacity:.5")">
        <div style="width:18px;height:18px;border-radius:5px;@(on ? "background:var(--brand);color:#fff" : "border:1.5px solid var(--line)");font-size:11px;display:flex;align-items:center;justify-content:center;flex:0 0 auto">@(on ? "✓" : "")</div>
        <div><div style="font-size:13px;font-weight:600">@t</div><div class="cap" style="margin-top:2px">@s</div></div></div>
    }
  </div>
</div>
