@* W4 Site detail: the seven parameters now, and the sensors at this province. *@
@model SiteDetailDto
@{
    var shell = (ShellDto)ViewData["Shell"]!;
    ViewData["Title"] = Model.Name;
    ViewData["Nav"] = "Sites";
    ViewData["Heading"] = Model.Name;
    ViewData["Sub"] = Model.Subtitle;
}
@section Right {
  <div class="selectbox"><span data-select-label>Last 24 hours</span>&nbsp;&nbsp;▾
    <select id="rangeSel" aria-label="Export range"><option value="24h">Last 24 hours</option><option value="7d">Last 7 days</option><option value="30d">Last 30 days</option></select></div>
  @if (shell.IsAdmin){<a class="btn ghost" asp-controller="Thresholds" asp-action="Index" asp-route-site="@Model.SiteId">Edit thresholds</a>}
  <a class="btn" id="exportBtn" asp-controller="Readings" asp-action="Export" asp-route-range="24h" asp-route-site="@Model.SiteId">Export CSV</a>
}
<div class="tabs narrow" style="width:100%">
  <div class="on">Live readings</div>
  <a asp-controller="Sensors" asp-action="Index" asp-route-site="@Model.SiteId">Sensors</a>
  @if (shell.IsAdmin){<a asp-controller="Thresholds" asp-action="Index" asp-route-site="@Model.SiteId">Thresholds</a>}
</div>
<div class="row" style="gap:10px;margin-top:-8px">
  <span class="dotpill" style="color:@Ui.Colour(Model.SummaryTone)"><s style="background:@Ui.Colour(Model.SummaryTone)"></s>@Model.Summary</span>
  <span class="cap">· @Model.Updated</span></div>

<div class="grid g4">
@foreach (var p in Model.Parameters)
{
  <div class="card" style="padding:18px 20px">
    <div style="display:flex;align-items:center;gap:8px">
      <s style="width:20px;height:4px;border-radius:2px;background:@p.Colour;display:block"></s>
      <span style="font-size:12px;font-weight:500;color:var(--tx2)">@p.Label</span></div>
    <div style="display:flex;align-items:baseline;gap:6px;margin-top:14px">
      <span style="font-size:30px;font-weight:700">@p.Value</span>
      <span style="font-size:12px;font-weight:500;color:var(--tx3)">@p.Unit</span></div>
    <div style="margin-top:6px">@Ui.Status(p.StatusLabel, p.Tone)</div>
    <div class="rng">
      <div style="height:5px;border-radius:3px;background:#E7EDE9"></div>
      <div style="position:absolute;left:18%;top:0;width:58%;height:5px;border-radius:3px;background:rgba(97,201,160,.55)"></div>
      <div style="position:absolute;left:calc(@(p.Position)% - 5px);top:-3px;width:11px;height:11px;border-radius:50%;background:#fff;border:3px solid @p.Colour"></div>
    </div></div>
}
</div>

<div class="card">
  <div class="cardhead">
    <div class="h3">Sensors at this site</div>
    <div class="cap">@Model.SensorsCaption</div>
    @if (shell.IsAdmin){<a class="btn ghost sm push" asp-controller="Sensors" asp-action="Register" asp-route-site="@Model.SiteId">Register sensor</a>}
  </div>
  <div class="tablewrap">
    <table><thead><tr>@foreach (var h in new[] { "Sensor", "Installed", "Last reading", "Status" }){<th>@h.ToUpperInvariant()</th>}</tr></thead>
    <tbody>
    @foreach (var s in Model.Sensors)
    {
      <tr><td style="font-weight:600">@s.SensorId</td><td class="num">@s.Installed</td><td class="num">@s.LastReading</td>
        <td>@Ui.Status(s.StateLabel, s.Tone)</td></tr>
    }
    </tbody></table>
  </div>
  @if (Model.Sensors.Count == 0){<div class="cap" style="padding:20px 0">No sensors registered here yet.</div>}
</div>
@section Scripts { <script>SensorGrid.initExportRange();</script> }
